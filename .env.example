# ==============================================================================
# Ticketera — Environment Variables Example
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Connection (PostgreSQL 16 with pg_trgm extension)
DATABASE_URL=postgresql://ticket:change-me@postgres:5432/ticketera?schema=public

# Redis Connection (BullMQ receipt ingestion queue)
REDIS_URL=redis://redis:6379/0

# NextAuth / Auth.js Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here_generate_with_openssl_rand_base64_32
NEXTAUTH_SECRET=your_auth_secret_here_generate_with_openssl_rand_base64_32
AUTH_TRUST_HOST=true

# Public Catalogue Access
# When "false" (default), all pages require login.
# When "true", catalogue and price comparison (/products, /stores, /compare) are public.
PUBLIC_CATALOG=false

# Optional First-Login Bootstrap Credentials
# If set, automatically creates the root ADMIN account on first server boot if no users exist.
# If omitted, the very first user who signs in via Credentials becomes ADMIN.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=change-this-secure-password

# AI Parsing API Keys (At least one required for receipt extraction)
# Ingestion order: Gemini 2.5 Flash -> Groq Llama 4 Scout -> GPT-4o-mini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Upload Storage Directory (Mapped to volume in Docker Compose)
UPLOAD_DIR=/app/uploads

# Canonical Public URL (Used for PWA manifest and OpenFoodFacts User-Agent)
NEXT_PUBLIC_APP_URL=http://localhost:3000
